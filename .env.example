# Server
PORT=5000
NODE_ENV=development

# Public base URL of this API (used by Swagger server URLs)
API_BASE_URL=http://localhost:5000
# Optional production base URL shown as a second server in Swagger
PRODUCTION_API_BASE_URL=https://api.example.com

# Frontend origin allowed by CORS (comma-separated list supported)
CLIENT_URL=http://localhost:3000,https://anamolhasan.vercel.app

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/anamolhasan

# Cloudinary — image hosting for portfolio uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Clerk — authentication (from dashboard.clerk.com)
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Swagger / OpenAPI documentation
# Enabled by default in development; set to true to enable it in production
SWAGGER_ENABLED=true
SWAGGER_PATH=/api-docs
